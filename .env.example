# ---------------------------------------------------------------------------
# Civio — variáveis de ambiente (NÃO coloque segredos reais aqui)
# Copie para .env.local no desenvolvimento e configure no provedor de hospedagem.
# Sem Supabase configurado, o app roda em MODO DEMONSTRAÇÃO (landing + lição
# de demonstração), sem banco de dados.
# ---------------------------------------------------------------------------

# URL pública do site (usada em redirects de e-mail/checkout).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (auth + banco) ------------------------------------------------
# Painel do Supabase > Project Settings > API.
# As duas NEXT_PUBLIC_ são públicas por natureza (o RLS protege os dados).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SOMENTE no servidor. Nunca use prefixo NEXT_PUBLIC_. Dá acesso total
# (ignora o RLS) — usada apenas por código de servidor confiável (correção,
# XP, webhooks). Mantenha em segredo.
SUPABASE_SERVICE_ROLE_KEY=

# --- Cobrança (Cakto) — desativada por padrão -------------------------------
# A integração está implementada (src/lib/billing/cakto.ts). A cobrança só liga
# quando TODAS estas estiverem presentes. Faça um teste com evento real antes
# de vender (ver README, seção 5). Enquanto isso, sem botão público de Premium.
CIVIO_BILLING_ENABLED=false
CAKTO_WEBHOOK_SECRET=
CAKTO_CHECKOUT_BASE_URL=
# Lista separada por vírgula de IDs de produto/plano Premium permitidos no webhook.
CAKTO_PREMIUM_PRODUCT_IDS=
