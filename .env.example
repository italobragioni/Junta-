# ---------------------------------------------------------------------------
# Finora — variáveis de ambiente (NÃO coloque segredos reais aqui)
# Copie para .env.local no desenvolvimento e configure no provedor de hospedagem.
# Sem Supabase configurado, o app roda em MODO DEMONSTRAÇÃO (landing), sem banco.
# ---------------------------------------------------------------------------

# URL pública do site (usada em redirects de e-mail de autenticação).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (auth + banco) ------------------------------------------------
# Painel do Supabase > Project Settings > API.
# As duas NEXT_PUBLIC_ são públicas por natureza (o RLS protege os dados).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SOMENTE no servidor. Nunca use prefixo NEXT_PUBLIC_. Dá acesso total
# (ignora o RLS). Usada apenas por código de servidor confiável. Opcional por
# enquanto — o app funciona sem ela.
SUPABASE_SERVICE_ROLE_KEY=

# --- Finora IA (assistente financeiro) — opcional ---------------------------
# Sem chave, a Finora IA funciona em MODO BÁSICO: responde perguntas comuns
# usando apenas os seus dados reais (sem inventar números). Com uma chave, as
# respostas ficam em linguagem natural mais rica — sempre ancoradas nos dados.
#
# Provedor: anthropic (padrão) | openai | gemini
FINORA_AI_PROVIDER=anthropic
FINORA_AI_API_KEY=
# Modelo (opcional; há um padrão por provedor):
#   anthropic: claude-haiku-5-5   | openai: gpt-4o-mini | gemini: gemini-2.0-flash
FINORA_AI_MODEL=
