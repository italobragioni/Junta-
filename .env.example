# ------------------------------------------------------------------
# Junta+ environment variables
# Copy this file to ".env" for local development and set real values.
# On Vercel, configure these in Project Settings → Environment Variables.
# ------------------------------------------------------------------

# PostgreSQL connection string (POOLED — used by the app at runtime).
# Recommended: Neon (available on the Vercel Storage / Marketplace).
# On Vercel, the Neon integration sets DATABASE_URL and DATABASE_URL_UNPOOLED
# for you automatically — you do not need to type them by hand there.
# Example: postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL="postgresql://user:password@host:5432/junta?sslmode=require"

# Direct (non-pooled) connection — used ONLY by `prisma migrate`.
# Locally you can set it to the SAME value as DATABASE_URL.
DATABASE_URL_UNPOOLED="postgresql://user:password@host:5432/junta?sslmode=require"

# Secret used to sign session cookies (JWT). MUST be a long random string.
# Generate one with:  openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-secret-value"

# (Optional) AI provider API key. When absent, the app uses a built-in
# rule-based assistant and never breaks. Wire a real provider in src/lib/ai.
# AI_API_KEY=""
